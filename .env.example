# Copy to .env.local; never commit real credentials.
# Neon pooled PostgreSQL URL; migrations also use this DATABASE_URL.
DATABASE_URL=
DASHSCOPE_API_KEY=
# Token for a PRIVATE Vercel Blob store (not a public store).
BLOB_READ_WRITE_TOKEN=

# Optional: canonical HTTPS origin after deployment.
APP_URL=
# Keep key, model and endpoints in the same Alibaba Cloud region/workspace.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen3.8-flash
QWEN_ASR_MODEL=qwen3-asr-flash-realtime
QWEN_ASR_WEBSOCKET_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
