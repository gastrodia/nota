{
  "name": "nota",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:recorder": "node --test tests/voice-recorder.test.mjs",
    "format": "prettier --write src docs tests scripts public/audio README.md package.json",
    "format:check": "prettier --check src docs tests scripts public/audio README.md package.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "cleanup:audio": "tsx scripts/cleanup-audio.ts",
    "test:backend": "tsx --test tests/backend.test.ts",
    "test:asr": "tsx --test tests/asr.test.ts",
    "test": "pnpm test:recorder && pnpm test:audio-draft && pnpm test:worker && pnpm test:backend && pnpm test:conversation && pnpm test:retrieval && pnpm test:asr && pnpm test:evaluation",
    "test:local": "tsx scripts/test-local.ts",
    "preview:test": "tsx scripts/preview-test.ts",
    "eval:live": "tsx scripts/evaluate.ts",
    "test:evaluation": "tsx --test tests/evaluation.test.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "test:worker": "tsx --test tests/worker.test.ts",
    "test:retrieval": "tsx --test tests/retrieval.test.ts",
    "test:conversation": "tsx --test tests/agent-conversation.test.ts",
    "test:audio-draft": "tsx --test tests/audio-draft.test.ts",
    "eval:compare": "tsx scripts/compare-evaluations.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^3.11.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "26.1.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": "22.x"
  }
